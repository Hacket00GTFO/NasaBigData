# NASA API key - solicita la tuya en https://api.nasa.gov/
# DEMO_KEY esta limitada a 30 req/hora y 50 req/dia
NASA_API_KEY=DEMO_KEY

# URLs base de los servicios
NASA_API_BASE_URL=https://api.nasa.gov
DONKI_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI-API/get
APOD_FALLBACK_BASE_URL=https://science.nasa.gov/wp-json/wp/v2/apod-basic
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3

# Rangos por defecto (en dias hacia atras desde hoy)
DEFAULT_DONKI_DAYS=30
DEFAULT_EONET_DAYS=180
DEFAULT_NEO_DAYS=7

# Cache de respuestas en segundos
CACHE_TIMEOUT=3600
CACHE_MAX_ENTRIES=512

# Servidor Flask
FLASK_PORT=8050
FLASK_DEBUG=False

# Pipeline de predicciones (valores por defecto comentados)
# DB_PATH=state/nasa_big_data.db
# MODELS_DIR=state/models
# FIRMS_MAP_KEY=              # map key gratuita: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# SCHEDULER_ENABLED=True
# SCHEDULER_COLLECT_HOURS=6
# SCHEDULER_TRAIN_HOUR=3
# DONKI_BACKFILL_TYPES=FLR,CME,GST,SEP
# DONKI_BACKFILL_START=2010-01-01
# EONET_BACKFILL_START=2000-01-01
# ML_TEST_DAYS=365
# ML_VALIDATION_DAYS=90
# ML_RECENCY_HALFLIFE_DAYS=1095
