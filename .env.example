# NASA API key - solicita la tuya en https://api.nasa.gov/
# DEMO_KEY esta limitada a 30 req/hora y 50 req/dia
NASA_API_KEY=DEMO_KEY

# URLs base de los servicios
NASA_API_BASE_URL=https://api.nasa.gov
DONKI_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI-API/get
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3

# Rangos por defecto (en dias hacia atras desde hoy)
DEFAULT_DONKI_DAYS=30
DEFAULT_EONET_DAYS=180
DEFAULT_NEO_DAYS=7

# Cache de respuestas en segundos
CACHE_TIMEOUT=3600
CACHE_MAX_ENTRIES=512

# Servidor Flask
FLASK_PORT=8050
FLASK_DEBUG=False
